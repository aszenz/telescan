{
  "$schema": "../app.schema.json",
  "id": "android-studio",
  "name": "Android Studio / Android SDK tools",
  "category": "editors",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends usage statistics and crash reports to Google after you opt in. The setting also covers the SDK command line tools.",
  "default_state": "off",
  "detect": {
    "paths": [
      "{home}/.android"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "hasOptedIn",
      "files": [
        "{home}/.android/analytics.settings"
      ],
      "disabled_when": [
        false
      ],
      "enabled_when": [
        true
      ]
    }
  ],
  "disable": {
    "steps": [
      "Settings > Appearance & Behavior > System Settings > Data Sharing: clear the box.",
      "Or set \"hasOptedIn\": false in ~/.android/analytics.settings. If ANDROID_PREFS_ROOT or ANDROID_SDK_HOME is set, the file is in that directory instead."
    ]
  },
  "docs": "https://developer.android.com/studio/preview/data-sharing",
  "verification": "qualified",
  "verified_at": "2026-09-24",
  "scope": [
    "usage-analytics",
    "crash-reporting"
  ],
  "evidence": [
    "https://developer.android.com/studio/intro/studio-config",
    "https://android.googlesource.com/platform/tools/analytics-library/+/refs/heads/studio-main/shared/src/main/java/com/android/tools/analytics/AnalyticsSettings.kt",
    "https://android.googlesource.com/platform/tools/analytics-library/+/refs/heads/studio-main/shared/src/main/java/com/android/tools/analytics/AnalyticsPaths.kt"
  ]
}
