{
  "$schema": "../app.schema.json",
  "id": "firefox",
  "name": "Mozilla Firefox",
  "category": "browsers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Checks the health-report upload preference in every discovered profile. Crash reporting, Firefox Suggest, and enterprise policy enforcement are not yet checked.",
  "default_state": "on",
  "detect": {
    "which": [
      "firefox"
    ],
    "paths": [
      "{home}/.mozilla/firefox",
      "{home}/Library/Application Support/Firefox",
      "{appdata}/Mozilla/Firefox"
    ]
  },
  "checks": [
    {
      "type": "regex",
      "files": [
        "{home}/.mozilla/firefox/*/prefs.js",
        "{home}/Library/Application Support/Firefox/Profiles/*/prefs.js",
        "{appdata}/Mozilla/Firefox/Profiles/*/prefs.js"
      ],
      "disabled_pattern": "user_pref\\(\"datareporting\\.healthreport\\.uploadEnabled\",\\s*false\\)",
      "enabled_pattern": "user_pref\\(\"datareporting\\.healthreport\\.uploadEnabled\",\\s*true\\)",
      "component": "usage",
      "profiles": true,
      "default_state": "on"
    }
  ],
  "disable": {
    "steps": [
      "Settings > Privacy & Security > Firefox Data Collection and Use: clear every box.",
      "Fleet wide: set DisableTelemetry to true in the policies.json enterprise policy."
    ]
  },
  "docs": "https://support.mozilla.org/kb/telemetry-clientid",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://firefox-admin-docs.mozilla.org/reference/policies/disabletelemetry/",
    "https://firefox-source-docs.mozilla.org/toolkit/components/telemetry/internals/preferences.html"
  ]
}
