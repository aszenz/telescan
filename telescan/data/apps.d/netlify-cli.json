{
  "$schema": "../app.schema.json",
  "id": "netlify-cli",
  "name": "Netlify CLI",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous command usage.",
  "default_state": "on",
  "detect": {
    "which": [
      "netlify",
      "ntl"
    ],
    "paths": [
      "{home}/.netlify"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "telemetryDisabled",
      "files": [
        "{config}/netlify/config.json",
        "{home}/Library/Preferences/netlify/config.json"
      ],
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Run: netlify --telemetry-disable"
    ],
    "commands": [
      "netlify --telemetry-disable"
    ]
  },
  "docs": "https://docs.netlify.com/api-and-cli-guides/cli-guides/get-started-with-cli/"
}
