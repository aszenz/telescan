{
  "$schema": "../app.schema.json",
  "id": "zed",
  "name": "Zed",
  "category": "editors",
  "platforms": [
    "linux",
    "macos"
  ],
  "what": "Client-side usage metrics and diagnostics (crash reports). Hosted-service and training-data policies are outside these local checks.",
  "default_state": "on",
  "detect": {
    "which": [
      "zed"
    ],
    "paths": [
      "{config}/zed/settings.json"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "telemetry.metrics",
      "files": [
        "{config}/zed/settings.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ],
      "component": "metrics"
    },
    {
      "type": "json",
      "key": "telemetry.diagnostics",
      "files": [
        "{config}/zed/settings.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ],
      "component": "diagnostics"
    }
  ],
  "disable": {
    "steps": [
      "Add to ~/.config/zed/settings.json: \"telemetry\": { \"diagnostics\": false, \"metrics\": false }"
    ]
  },
  "docs": "https://zed.dev/docs/telemetry"
}
