{
  "$schema": "../app.schema.json",
  "id": "stripe-cli",
  "name": "Stripe CLI",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous command usage to Stripe.",
  "default_state": "on",
  "detect": {
    "which": [
      "stripe"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "STRIPE_CLI_TELEMETRY_OPTOUT",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set STRIPE_CLI_TELEMETRY_OPTOUT=1."
    ],
    "env": {
      "STRIPE_CLI_TELEMETRY_OPTOUT": "1"
    }
  },
  "docs": "https://docs.stripe.com/stripe-cli"
}
