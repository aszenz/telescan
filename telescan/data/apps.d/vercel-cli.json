{
  "$schema": "../app.schema.json",
  "id": "vercel-cli",
  "name": "Vercel CLI",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous command usage to Vercel.",
  "default_state": "on",
  "detect": {
    "which": [
      "vercel",
      "vc"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "VERCEL_TELEMETRY_DISABLED",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Run: vercel telemetry disable",
      "In CI set VERCEL_TELEMETRY_DISABLED=1."
    ],
    "commands": [
      "vercel telemetry disable"
    ],
    "env": {
      "VERCEL_TELEMETRY_DISABLED": "1"
    }
  },
  "docs": "https://vercel.com/docs/cli/about-telemetry"
}
