{
  "$schema": "../app.schema.json",
  "id": "snyk",
  "name": "Snyk CLI",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous analytics about CLI runs.",
  "default_state": "on",
  "detect": {
    "which": [
      "snyk"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "SNYK_DISABLE_ANALYTICS",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "json",
      "key": "disable-analytics",
      "files": [
        "{home}/.config/configstore/snyk.json"
      ],
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Run: snyk config set disable-analytics=1",
      "Or set SNYK_DISABLE_ANALYTICS=1."
    ],
    "commands": [
      "snyk config set disable-analytics=1"
    ],
    "env": {
      "SNYK_DISABLE_ANALYTICS": "1"
    }
  },
  "docs": "https://docs.snyk.io/snyk-cli/commands/config"
}
