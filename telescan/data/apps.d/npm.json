{
  "$schema": "../app.schema.json",
  "id": "npm",
  "name": "npm",
  "category": "package-managers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "The update notifier checks the registry for a newer npm version. It is on by default. npm has no usage telemetry; the registry still sees install and audit requests.",
  "default_state": "on",
  "detect": {
    "which": [
      "npm"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "npm_config_update_notifier",
      "disabled_when": [
        "false"
      ],
      "enabled_when": [
        "true"
      ]
    },
    {
      "type": "env",
      "var": "NPM_CONFIG_UPDATE_NOTIFIER",
      "disabled_when": [
        "false"
      ],
      "enabled_when": [
        "true"
      ]
    },
    {
      "type": "regex",
      "files": [
        ".npmrc",
        "{home}/.npmrc"
      ],
      "disabled_pattern": "(?m)^\\s*update-notifier\\s*=\\s*false\\s*$",
      "enabled_pattern": "(?m)^\\s*update-notifier\\s*=\\s*true\\s*$"
    }
  ],
  "disable": {
    "steps": [
      "Run: npm config set update-notifier false",
      "Use --no-audit to skip audit requests. --no-fund only hides funding output."
    ],
    "commands": [
      "npm config set update-notifier false"
    ],
    "env": {
      "npm_config_update_notifier": "false"
    }
  },
  "docs": "https://docs.npmjs.com/cli/v10/using-npm/config#update-notifier",
  "verification": "qualified",
  "verified_at": "2026-09-24",
  "scope": [
    "update-checks"
  ],
  "evidence": [
    "https://github.com/npm/cli/blob/latest/lib/cli/update-notifier.js",
    "https://docs.npmjs.com/cli/using-npm/config"
  ]
}
