{
  "$schema": "../app.schema.json",
  "id": "npm",
  "name": "npm",
  "category": "package-managers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "No usage telemetry. The registry still sees install and audit requests, and the update notifier makes a separate version check.",
  "default_state": "off",
  "detect": {
    "which": [
      "npm"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "npm_config_update_notifier",
      "disabled_when": [
        "false"
      ],
      "enabled_when": [
        "true"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Nothing to opt out of.",
      "To disable the update check, run: npm config set update-notifier false.",
      "Use --no-audit to skip audit requests. --no-fund only hides funding output."
    ],
    "commands": [
      "npm config set update-notifier false"
    ],
    "env": {
      "npm_config_update_notifier": "false"
    }
  },
  "docs": "https://docs.npmjs.com/cli/v10/using-npm/config#update-notifier",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "update-checks"
  ],
  "evidence": [
    "https://github.com/npm/cli/blob/latest/lib/cli/update-notifier.js",
    "https://docs.npmjs.com/cli/using-npm/config"
  ]
}
