{
  "$schema": "../app.schema.json",
  "id": "cordova",
  "name": "Apache Cordova",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous command usage to Google Analytics.",
  "default_state": "on",
  "detect": {
    "which": [
      "cordova"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "telemetry",
      "files": [
        "{home}/.cordova/config.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Run: cordova telemetry off"
    ],
    "commands": [
      "cordova telemetry off"
    ]
  },
  "docs": "https://cordova.apache.org/docs/en/latest/reference/cordova-cli/#cordova-telemetry-command"
}
