{
  "$schema": "../app.schema.json",
  "id": "cordova",
  "name": "Apache Cordova CLI",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "CLI 13 and later has no telemetry. Older releases offered opt-in command-usage telemetry.",
  "default_state": "off",
  "detect": {
    "which": [
      "cordova"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "telemetry",
      "files": [
        "{home}/.cordova/config.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "CLI 13 and later: nothing to disable. On CLI 12 and earlier, run: cordova telemetry off."
    ],
    "commands": [
      "cordova telemetry off"
    ]
  },
  "docs": "https://cordova.apache.org/announcements/2025/11/25/cordova-cli-13.0.0.html"
}
