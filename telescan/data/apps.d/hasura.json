{
  "$schema": "../app.schema.json",
  "id": "hasura",
  "name": "Hasura CLI / GraphQL Engine",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous usage of the CLI, console and server.",
  "default_state": "on",
  "detect": {
    "which": [
      "hasura"
    ],
    "paths": [
      "{home}/.hasura"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "HASURA_GRAPHQL_ENABLE_TELEMETRY",
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    },
    {
      "type": "json",
      "key": "enable_telemetry",
      "files": [
        "{home}/.hasura/config.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "CLI: set enable_telemetry: false in ~/.hasura/config.json.",
      "Server: set HASURA_GRAPHQL_ENABLE_TELEMETRY=false."
    ],
    "env": {
      "HASURA_GRAPHQL_ENABLE_TELEMETRY": "false"
    }
  },
  "docs": "https://hasura.io/docs/2.0/policies/telemetry/"
}
