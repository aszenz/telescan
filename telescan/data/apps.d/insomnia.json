{
  "$schema": "../app.schema.json",
  "id": "insomnia",
  "name": "Insomnia",
  "category": "desktop-apps",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends usage analytics to Kong. The app also sends analytics for a logged-in account when \"Send usage statistics\" is off.",
  "default_state": "on",
  "detect": {
    "paths": [
      "{config}/Insomnia",
      "{home}/Library/Application Support/Insomnia"
    ]
  },
  "checks": [
    {
      "type": "manual"
    }
  ],
  "disable": {
    "steps": [
      "Preferences > General: clear \"Send usage statistics\".",
      "Log out of your Kong account: a logged-in account still sends analytics.",
      "Inso CLI: set INSO_TELEMETRY_DISABLED=1."
    ]
  },
  "docs": "https://docs.insomnia.rest/insomnia/application-data",
  "verification": "qualified",
  "verified_at": "2026-09-24",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://developer.konghq.com/insomnia/collected-data/",
    "https://github.com/Kong/insomnia/blob/develop/packages/insomnia/src/main/analytics.ts",
    "https://github.com/Kong/insomnia/blob/develop/packages/insomnia-data/src/models/settings.ts"
  ]
}
