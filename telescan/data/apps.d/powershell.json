{
  "$schema": "../app.schema.json",
  "id": "powershell",
  "name": "PowerShell (7+)",
  "category": "package-managers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends the OS name and PowerShell version at start up to Microsoft.",
  "default_state": "on",
  "detect": {
    "which": [
      "pwsh"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "POWERSHELL_TELEMETRY_OPTOUT",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set POWERSHELL_TELEMETRY_OPTOUT=1 before PowerShell starts."
    ],
    "env": {
      "POWERSHELL_TELEMETRY_OPTOUT": "1"
    }
  },
  "docs": "https://learn.microsoft.com/powershell/module/microsoft.powershell.core/about/about_telemetry"
}
