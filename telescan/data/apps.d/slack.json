{
  "$schema": "../app.schema.json",
  "id": "slack",
  "name": "Slack desktop",
  "category": "desktop-apps",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Client usage is logged server side. There is no local opt-out switch.",
  "default_state": "on",
  "detect": {
    "paths": [
      "{config}/Slack",
      "{home}/Library/Application Support/Slack",
      "{appdata}/Slack"
    ]
  },
  "checks": [
    {
      "type": "manual"
    }
  ],
  "disable": {
    "steps": [
      "No local switch. Workspace owners on paid plans control the analytics and retention settings.",
      "Block third party trackers at the network level if this matters to you."
    ]
  },
  "docs": "https://slack.com/trust/privacy/privacy-policy",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics",
    "service-data"
  ],
  "evidence": [
    "https://slack.com/help/articles/360057613913-Manage-permissions-for-the-Slack-analytics-dashboard",
    "https://slack.com/trust/privacy/privacy-policy"
  ]
}
