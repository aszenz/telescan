{
  "$schema": "../app.schema.json",
  "id": "docker-cli-hints",
  "name": "Docker CLI (hints and Scout)",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "The CLI prints Docker Scout hints and checks for advice, which contacts Docker.",
  "default_state": "on",
  "detect": {
    "which": [
      "docker"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "DOCKER_CLI_HINTS",
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    },
    {
      "type": "json",
      "key": "hints",
      "files": [
        "{home}/.docker/config.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set \"hints\": false in ~/.docker/config.json, or export DOCKER_CLI_HINTS=false."
    ],
    "env": {
      "DOCKER_CLI_HINTS": "false"
    }
  },
  "docs": "https://docs.docker.com/reference/cli/docker/"
}
