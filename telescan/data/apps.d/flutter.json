{
  "$schema": "../app.schema.json",
  "id": "flutter",
  "name": "Flutter / Dart SDK",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends command usage and crash data to Google.",
  "default_state": "on",
  "detect": {
    "which": [
      "flutter",
      "dart"
    ],
    "paths": [
      "{home}/.dart-tool",
      "{home}/.flutter"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "FLUTTER_SUPPRESS_ANALYTICS",
      "disabled_when": [
        "true"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "regex",
      "files": [
        "{home}/.dart-tool/dart-flutter-telemetry.config"
      ],
      "disabled_pattern": "^reporting=0",
      "enabled_pattern": "^reporting=1"
    }
  ],
  "disable": {
    "steps": [
      "Run: flutter --disable-analytics",
      "Run: dart --disable-analytics",
      "In CI set FLUTTER_SUPPRESS_ANALYTICS=true."
    ],
    "commands": [
      "flutter --disable-analytics",
      "dart --disable-analytics"
    ],
    "env": {
      "FLUTTER_SUPPRESS_ANALYTICS": "true"
    }
  },
  "docs": "https://docs.flutter.dev/reference/crash-reporting",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics",
    "crash-reporting"
  ],
  "evidence": [
    "https://docs.flutter.dev/reference/crash-reporting",
    "https://github.com/flutter/flutter/blob/master/packages/flutter_tools/lib/src/reporting/unified_analytics.dart",
    "https://github.com/dart-lang/tools/blob/main/pkgs/unified_analytics/lib/src/config_handler.dart"
  ]
}
