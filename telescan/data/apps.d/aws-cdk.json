{
  "$schema": "../app.schema.json",
  "id": "aws-cdk",
  "name": "AWS CDK 2.1100.0+",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "CLI telemetry sends command usage and error metrics. Version reporting separately adds a CDKMetadata resource to deployed stacks.",
  "default_state": "on",
  "detect": {
    "which": [
      "cdk"
    ],
    "paths": [
      "node_modules/aws-cdk-lib",
      "cdk.json"
    ]
  },
  "checks": [
    {
      "type": "json",
      "component": "library version reporting",
      "key": "versionReporting",
      "files": [
        "cdk.json",
        "{home}/.cdk.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    },
    {
      "type": "env",
      "component": "CLI telemetry",
      "var": "CDK_DISABLE_CLI_TELEMETRY",
      "disabled_when": [
        "true"
      ],
      "enabled_when": [
        "false"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set \"versionReporting\": false in cdk.json.",
      "Run: cdk cli-telemetry --disable.",
      "In CI set CDK_DISABLE_CLI_TELEMETRY=true."
    ],
    "commands": [
      "cdk cli-telemetry --disable"
    ],
    "env": {
      "CDK_DISABLE_CLI_TELEMETRY": "true"
    }
  },
  "docs": "https://docs.aws.amazon.com/cdk/v2/guide/cli-telemetry.html"
}
