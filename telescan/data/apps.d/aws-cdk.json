{
  "$schema": "../app.schema.json",
  "id": "aws-cdk",
  "name": "AWS CDK",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Version reporting adds a CDKMetadata resource to every stack, which tells AWS which constructs you use.",
  "default_state": "on",
  "detect": {
    "which": [
      "cdk"
    ],
    "paths": [
      "node_modules/aws-cdk-lib",
      "cdk.json"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "versionReporting",
      "files": [
        "cdk.json",
        "{home}/.cdk.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set \"versionReporting\": false in cdk.json.",
      "Or pass --no-version-reporting to each cdk command."
    ]
  },
  "docs": "https://docs.aws.amazon.com/cdk/v2/guide/cli.html"
}
