{
  "$schema": "../app.schema.json",
  "id": "salesforce-cli",
  "name": "Salesforce CLI (sf)",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends command usage and error data to Salesforce.",
  "default_state": "on",
  "detect": {
    "which": [
      "sf",
      "sfdx"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "SF_DISABLE_TELEMETRY",
      "exact": true,
      "disabled_when": [
        "true"
      ],
      "enabled_when": [
        "*nonempty*"
      ]
    },
    {
      "type": "env",
      "var": "SFDX_DISABLE_TELEMETRY",
      "exact": true,
      "disabled_when": [
        "true"
      ],
      "enabled_when": [
        "*nonempty*"
      ]
    },
    {
      "type": "json",
      "key": "disable-telemetry",
      "files": [
        ".sf/config.json",
        "{home}/.sf/config.json"
      ],
      "exact": true,
      "disabled_when": [
        "true"
      ],
      "enabled_when": [
        "*nonempty*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Run: sf config set disable-telemetry=true --global",
      "Or set SF_DISABLE_TELEMETRY=true. Only the lowercase string \"true\" works.",
      "Legacy ~/.sfdx/sfdx-config.json settings are not read by this check."
    ],
    "commands": [
      "sf config set disable-telemetry=true --global"
    ],
    "env": {
      "SF_DISABLE_TELEMETRY": "true"
    }
  },
  "docs": "https://developer.salesforce.com/docs/atlas.en-us.sfdx_setup.meta/sfdx_setup/sfdx_dev_cli_telemetry.htm",
  "verification": "qualified",
  "verified_at": "2026-09-24",
  "scope": [
    "usage-analytics",
    "crash-reporting"
  ],
  "evidence": [
    "https://github.com/salesforcecli/plugin-telemetry",
    "https://developer.salesforce.com/docs/atlas.en-us.sfdx_setup.meta/sfdx_setup/sfdx_dev_cli_telemetry.htm",
    "https://github.com/forcedotcom/telemetry/blob/main/src/enabledCheck.ts",
    "https://github.com/forcedotcom/sfdx-core/blob/main/src/config/envVars.ts",
    "https://github.com/forcedotcom/sfdx-core/blob/main/src/config/configAggregator.ts"
  ]
}
