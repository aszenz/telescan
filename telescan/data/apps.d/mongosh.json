{
  "$schema": "../app.schema.json",
  "id": "mongosh",
  "name": "MongoDB Shell (mongosh)",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous usage events to MongoDB.",
  "default_state": "on",
  "detect": {
    "which": [
      "mongosh"
    ],
    "paths": [
      "{home}/.mongodb/mongosh"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "enableTelemetry",
      "files": [
        "{home}/.mongodb/mongosh/config"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "In mongosh run: disableTelemetry()"
    ]
  },
  "docs": "https://www.mongodb.com/docs/mongodb-shell/telemetry/",
  "verification": "confirmed",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://www.mongodb.com/docs/mongodb-shell/telemetry/",
    "https://www.mongodb.com/community/forums/t/how-to-check-status-of-mongosh-telemetry/249531"
  ]
}
