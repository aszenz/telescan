{
  "$schema": "../app.schema.json",
  "id": "playwright",
  "name": "Playwright",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "The audit found no documented telemetry opt-out. Playwright downloads browser builds from a Microsoft CDN. That does not prove that it sends no usage data.",
  "default_state": "unknown",
  "detect": {
    "which": [
      "playwright"
    ],
    "paths": [
      "node_modules/@playwright"
    ]
  },
  "checks": [
    {
      "type": "manual"
    }
  ],
  "disable": {
    "steps": [
      "No documented switch. Review browser downloads and the services your tests call."
    ]
  },
  "docs": "https://playwright.dev/",
  "verification": "unresolved",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://playwright.dev/docs/browsers",
    "https://playwright.dev/docs/test-use-options"
  ]
}
