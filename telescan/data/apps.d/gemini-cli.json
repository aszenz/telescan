{
  "$schema": "../app.schema.json",
  "id": "gemini-cli",
  "name": "Gemini CLI",
  "category": "ai-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends usage statistics to Google.",
  "default_state": "on",
  "detect": {
    "which": [
      "gemini"
    ],
    "paths": [
      "{home}/.gemini"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "privacy.usageStatisticsEnabled",
      "files": [
        "/etc/gemini-cli/settings.json",
        "{programdata}/gemini-cli/settings.json",
        "{home}/Library/Application Support/GeminiCli/settings.json",
        ".gemini/settings.json",
        "{home}/.gemini/settings.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set \"privacy\": { \"usageStatisticsEnabled\": false } in ~/.gemini/settings.json, then restart Gemini CLI."
    ]
  },
  "docs": "https://geminicli.com/docs/reference/configuration/",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://geminicli.com/docs/reference/configuration/"
  ]
}
