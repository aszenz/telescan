{
  "$schema": "../app.schema.json",
  "id": "gemini-cli",
  "name": "Gemini CLI",
  "category": "ai-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends usage statistics to Google.",
  "default_state": "on",
  "detect": {
    "which": [
      "gemini"
    ],
    "paths": [
      "{home}/.gemini"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "usageStatisticsEnabled",
      "files": [
        "{home}/.gemini/settings.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set \"usageStatisticsEnabled\": false in ~/.gemini/settings.json."
    ]
  },
  "docs": "https://google-gemini.github.io/gemini-cli/docs/telemetry.html"
}
