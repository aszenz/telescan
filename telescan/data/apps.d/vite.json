{
  "$schema": "../app.schema.json",
  "id": "vite",
  "name": "Vite",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "The audit found no documented telemetry opt-out in Vite core. That does not prove that Vite, its plugins or its integrations send no data.",
  "default_state": "unknown",
  "detect": {
    "which": [
      "vite"
    ],
    "paths": [
      "node_modules/vite"
    ]
  },
  "checks": [
    {
      "type": "manual"
    }
  ],
  "disable": {
    "steps": [
      "No documented switch. Review the plugins and integrations you use."
    ]
  },
  "docs": "https://vite.dev/",
  "verification": "unresolved",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://vite.dev/guide/"
  ]
}
