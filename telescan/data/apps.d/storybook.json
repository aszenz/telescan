{
  "$schema": "../app.schema.json",
  "id": "storybook",
  "name": "Storybook",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous usage of builders, framework and addons.",
  "default_state": "on",
  "detect": {
    "paths": [
      "node_modules/storybook",
      "node_modules/@storybook",
      ".storybook"
    ]
  },
  "checks": [
    {
      "type": "env",
      "component": "regular telemetry",
      "var": "STORYBOOK_DISABLE_TELEMETRY",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "regex",
      "component": "regular telemetry",
      "files": [
        ".storybook/main.js",
        ".storybook/main.ts"
      ],
      "disabled_pattern": "disableTelemetry:\\s*true"
    },
    {
      "type": "env",
      "component": "startup event",
      "var": "STORYBOOK_DISABLE_TELEMETRY",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set STORYBOOK_DISABLE_TELEMETRY=1 before Storybook starts to disable all automatic telemetry, including the startup event.",
      "core: { disableTelemetry: true } disables later telemetry but does not suppress the startup event."
    ],
    "env": {
      "STORYBOOK_DISABLE_TELEMETRY": "1"
    }
  },
  "docs": "https://storybook.js.org/docs/configure/telemetry"
}
