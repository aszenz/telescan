{
  "$schema": "../app.schema.json",
  "id": "redwood",
  "name": "RedwoodJS",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous CLI command and error data.",
  "default_state": "on",
  "detect": {
    "paths": [
      "node_modules/@redwoodjs"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "REDWOOD_DISABLE_TELEMETRY",
      "disabled_when": [
        "*nonempty*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set REDWOOD_DISABLE_TELEMETRY=1."
    ],
    "env": {
      "REDWOOD_DISABLE_TELEMETRY": "1"
    }
  },
  "docs": "https://redwoodjs.com/docs/telemetry",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics",
    "crash-reporting"
  ],
  "evidence": [
    "https://github.com/redwoodjs/redwood/blob/main/packages/telemetry/src/telemetry.ts",
    "https://docs.redwoodjs.com/docs/cli-commands"
  ]
}
