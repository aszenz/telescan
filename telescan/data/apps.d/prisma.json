{
  "$schema": "../app.schema.json",
  "id": "prisma",
  "name": "Prisma CLI",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Prisma 8 can send CLI usage telemetry. Prisma 6 used a separate HashiCorp Checkpoint version check.",
  "default_state": "on",
  "detect": {
    "paths": [
      "node_modules/prisma",
      "node_modules/@prisma"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "CHECKPOINT_DISABLE",
      "versions": "<7",
      "disabled_when": [
        "1"
      ]
    },
    {
      "type": "manual",
      "versions": ">=7"
    }
  ],
  "disable": {
    "steps": [
      "Prisma 8: run prisma telemetry disable; verify with prisma telemetry status.",
      "Prisma 6: set CHECKPOINT_DISABLE=1 to disable the legacy version check."
    ],
    "commands": [
      "prisma telemetry disable"
    ]
  },
  "docs": "https://docs.prisma.io/docs/cli/telemetry.md",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics",
    "update-checks"
  ],
  "evidence": [
    "https://www.prisma.io/docs/orm/v6/tools/prisma-cli",
    "https://docs.prisma.io/docs/cli/telemetry.md"
  ],
  "version": {
    "files": [
      "node_modules/prisma/package.json"
    ],
    "key": "version",
    "argv": [
      "prisma",
      "--version"
    ]
  }
}
