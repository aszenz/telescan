{
  "$schema": "../app.schema.json",
  "id": "prisma",
  "name": "Prisma",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Uses the HashiCorp checkpoint client for version checks, which sends a request with machine data.",
  "default_state": "on",
  "detect": {
    "paths": [
      "node_modules/prisma",
      "node_modules/@prisma"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "CHECKPOINT_DISABLE",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set CHECKPOINT_DISABLE=1 in your shell profile and in CI."
    ],
    "env": {
      "CHECKPOINT_DISABLE": "1"
    }
  },
  "docs": "https://www.prisma.io/docs/orm/more/help-and-troubleshooting/prisma-cli-telemetry"
}
