{
  "$schema": "../app.schema.json",
  "id": "vagrant",
  "name": "Vagrant",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Checks for updates through the HashiCorp checkpoint service.",
  "default_state": "on",
  "detect": {
    "which": [
      "vagrant"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "VAGRANT_CHECKPOINT_DISABLE",
      "disabled_when": [
        "*nonempty*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set VAGRANT_CHECKPOINT_DISABLE=1."
    ],
    "env": {
      "VAGRANT_CHECKPOINT_DISABLE": "1"
    }
  },
  "docs": "https://developer.hashicorp.com/vagrant/docs/other/environmental-variables",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "update-checks"
  ],
  "evidence": [
    "https://developer.hashicorp.com/vagrant/docs/other/environmental-variables"
  ]
}
