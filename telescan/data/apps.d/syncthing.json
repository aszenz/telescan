{
  "$schema": "../app.schema.json",
  "id": "syncthing",
  "name": "Syncthing",
  "category": "desktop-apps",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Optional anonymous usage reporting to the Syncthing project.",
  "default_state": "unknown",
  "detect": {
    "which": [
      "syncthing"
    ],
    "paths": [
      "{config}/syncthing/config.xml",
      "{home}/Library/Application Support/Syncthing/config.xml"
    ]
  },
  "checks": [
    {
      "type": "regex",
      "component": "usage reporting",
      "files": [
        "{config}/syncthing/config.xml",
        "{data}/syncthing/config.xml",
        "{home}/Library/Application Support/Syncthing/config.xml",
        "{localappdata}/Syncthing/config.xml"
      ],
      "disabled_pattern": "<urAccepted>-1</urAccepted>",
      "enabled_pattern": "<urAccepted>[1-9][0-9]*</urAccepted>"
    },
    {
      "type": "regex",
      "component": "crash reporting",
      "files": [
        "{config}/syncthing/config.xml",
        "{data}/syncthing/config.xml",
        "{home}/Library/Application Support/Syncthing/config.xml",
        "{localappdata}/Syncthing/config.xml"
      ],
      "disabled_pattern": "<crashReportingEnabled>false</crashReportingEnabled>",
      "enabled_pattern": "<crashReportingEnabled>true</crashReportingEnabled>"
    }
  ],
  "disable": {
    "steps": [
      "Web UI > Settings: set Anonymous Usage Reporting to No (this writes urAccepted -1).",
      "Also turn off crash reporting (crashReportingEnabled=false)."
    ]
  },
  "docs": "https://docs.syncthing.net/users/config.html",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics",
    "crash-reporting"
  ],
  "evidence": [
    "https://docs.syncthing.net/users/config.html",
    "https://docs.syncthing.net/users/tuning"
  ]
}
