{
  "$schema": "../app.schema.json",
  "id": "chrome",
  "name": "Google Chrome",
  "category": "browsers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Usage statistics and crash reports go to Google when the metrics option is on.",
  "default_state": "unknown",
  "detect": {
    "paths": [
      "{config}/google-chrome/Local State",
      "{home}/Library/Application Support/Google/Chrome/Local State",
      "{localappdata}/Google/Chrome/User Data/Local State"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "user_experience_metrics.reporting_enabled",
      "files": [
        "{config}/google-chrome/Local State",
        "{home}/Library/Application Support/Google/Chrome/Local State",
        "{localappdata}/Google/Chrome/User Data/Local State"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Settings > You and Google > Sync and Google services: turn off \"Help improve Chrome's features and performance\".",
      "Fleet wide: set the MetricsReportingEnabled policy to false."
    ]
  },
  "docs": "https://chromeenterprise.google/policies/#MetricsReportingEnabled"
}
