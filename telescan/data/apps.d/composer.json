{
  "$schema": "../app.schema.json",
  "id": "composer",
  "name": "Composer",
  "category": "package-managers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "No usage analytics. By default Composer may notify third-party repositories when one of their packages is installed.",
  "default_state": "on",
  "detect": {
    "which": [
      "composer"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "config.notify-on-install",
      "files": [
        "composer.json",
        "{config}/composer/config.json",
        "{appdata}/Composer/config.json"
      ],
      "disabled_when": [
        false
      ],
      "enabled_when": [
        true
      ]
    }
  ],
  "disable": {
    "steps": [
      "Run: composer config --global notify-on-install false."
    ],
    "commands": [
      "composer config --global notify-on-install false"
    ]
  },
  "docs": "https://getcomposer.org/doc/06-config.md#notify-on-install",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "service-data"
  ],
  "evidence": [
    "https://getcomposer.org/doc/06-config.md#notify-on-install"
  ]
}
