{
  "$schema": "../app.schema.json",
  "id": "serverless",
  "name": "Serverless Framework",
  "category": "cloud-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous command and service data.",
  "default_state": "on",
  "detect": {
    "which": [
      "serverless",
      "sls"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "SLS_TELEMETRY_DISABLED",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Run: serverless slstats --disable",
      "Or set SLS_TELEMETRY_DISABLED=1."
    ],
    "commands": [
      "serverless slstats --disable"
    ],
    "env": {
      "SLS_TELEMETRY_DISABLED": "1"
    }
  },
  "docs": "https://www.serverless.com/framework/docs/guides/telemetry",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://github.com/serverless/serverless/blob/v3.40.0/lib/utils/telemetry/are-disabled.js"
  ]
}
