{
  "$schema": "../app.schema.json",
  "id": "astro",
  "name": "Astro",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous data about the config and integrations you build with.",
  "default_state": "on",
  "detect": {
    "paths": [
      "node_modules/astro",
      "{config}/astro/config.json",
      "{home}/Library/Preferences/astro/config.json",
      "{appdata}/astro/Config/config.json"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "ASTRO_TELEMETRY_DISABLED",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "json",
      "key": "telemetry.enabled",
      "files": [
        "{config}/astro/config.json",
        "{home}/Library/Preferences/astro/config.json",
        "{appdata}/astro/Config/config.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Run: npx astro telemetry disable",
      "In CI set ASTRO_TELEMETRY_DISABLED=1."
    ],
    "commands": [
      "npx astro telemetry disable"
    ],
    "env": {
      "ASTRO_TELEMETRY_DISABLED": "1"
    }
  },
  "docs": "https://astro.build/telemetry/",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://astro.build/telemetry/",
    "https://github.com/withastro/astro/blob/main/packages/telemetry/src/index.ts",
    "https://github.com/withastro/astro/blob/main/packages/telemetry/src/config-keys.ts",
    "https://github.com/withastro/astro/blob/main/packages/telemetry/src/config.ts"
  ]
}
