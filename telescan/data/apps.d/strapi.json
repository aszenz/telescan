{
  "$schema": "../app.schema.json",
  "id": "strapi",
  "name": "Strapi",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous project and usage events.",
  "default_state": "on",
  "detect": {
    "paths": [
      "node_modules/@strapi"
    ]
  },
  "checks": [
    {
      "type": "env",
      "var": "STRAPI_TELEMETRY_DISABLED",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "json",
      "key": "strapi.telemetryDisabled",
      "files": [
        "package.json"
      ],
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Add \"telemetryDisabled\": true under the \"strapi\" key of package.json.",
      "Or set STRAPI_TELEMETRY_DISABLED=1."
    ],
    "env": {
      "STRAPI_TELEMETRY_DISABLED": "1"
    }
  },
  "docs": "https://docs.strapi.io/cms/data-management/telemetry",
  "verification": "confirmed",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://docs.strapi.io/cms/configurations/environment",
    "https://github.com/strapi/strapi/blob/main/packages/core/core/src/services/metrics/index.ts"
  ]
}
