{
  "$schema": "../app.schema.json",
  "id": "vscode",
  "name": "Visual Studio Code",
  "category": "editors",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Usage events, error telemetry and crash reports sent to Microsoft. Extensions send their own telemetry, which the same setting gates.",
  "default_state": "on",
  "detect": {
    "which": [
      "code"
    ],
    "paths": [
      "{config}/Code/User/settings.json",
      "{home}/Library/Application Support/Code/User/settings.json"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "telemetry.telemetryLevel",
      "files": [
        "{config}/Code/User/settings.json",
        "{home}/Library/Application Support/Code/User/settings.json"
      ],
      "disabled_when": [
        "off"
      ],
      "enabled_when": [
        "all",
        "error",
        "crash"
      ]
    },
    {
      "type": "json",
      "key": "telemetry.enableTelemetry",
      "files": [
        "{config}/Code/User/settings.json",
        "{home}/Library/Application Support/Code/User/settings.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set \"telemetry.telemetryLevel\": \"off\" in settings.json (Preferences > Settings > search for telemetry).",
      "Start the editor with --disable-telemetry for a single run."
    ]
  },
  "docs": "https://code.visualstudio.com/docs/configure/telemetry",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics",
    "crash-reporting"
  ],
  "evidence": [
    "https://code.visualstudio.com/docs/configure/telemetry"
  ]
}
