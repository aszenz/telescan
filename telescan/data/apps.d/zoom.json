{
  "$schema": "../app.schema.json",
  "id": "zoom",
  "name": "Zoom",
  "category": "desktop-apps",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Product usage and quality data go to Zoom.",
  "default_state": "on",
  "detect": {
    "paths": [
      "{home}/.zoom",
      "{home}/Library/Application Support/zoom.us",
      "{appdata}/Zoom"
    ]
  },
  "checks": [
    {
      "type": "manual"
    }
  ],
  "disable": {
    "steps": [
      "Zoom web portal > Settings: turn off the product usage and marketing data options your account exposes.",
      "There is no local file to flip."
    ]
  },
  "docs": "https://explore.zoom.us/en/privacy/",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics",
    "service-data"
  ],
  "evidence": [
    "https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0057779"
  ]
}
