{
  "$schema": "../app.schema.json",
  "id": "claude-code",
  "name": "Claude Code",
  "category": "ai-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends usage telemetry and error reports to Anthropic.",
  "default_state": "on",
  "detect": {
    "which": [
      "claude"
    ],
    "paths": [
      "{home}/.claude"
    ]
  },
  "checks": [
    {
      "type": "env",
      "component": "usage",
      "var": "DISABLE_TELEMETRY",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "json",
      "component": "usage",
      "key": "env.DISABLE_TELEMETRY",
      "files": [
        "{home}/.claude/settings.json"
      ],
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "env",
      "component": "usage",
      "var": "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "json",
      "component": "usage",
      "key": "env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
      "files": [
        "{home}/.claude/settings.json"
      ],
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "env",
      "component": "errors",
      "var": "DISABLE_ERROR_REPORTING",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "json",
      "component": "errors",
      "key": "env.DISABLE_ERROR_REPORTING",
      "files": [
        "{home}/.claude/settings.json"
      ],
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "env",
      "component": "errors",
      "var": "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    },
    {
      "type": "json",
      "component": "errors",
      "key": "env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
      "files": [
        "{home}/.claude/settings.json"
      ],
      "disabled_when": [
        "*truthy*"
      ],
      "enabled_when": [
        "*falsy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Set DISABLE_TELEMETRY=1 and DISABLE_ERROR_REPORTING=1 to disable usage telemetry and error reporting.",
      "Alternatively set CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1; this also disables automatic updates and the feedback command.",
      "These variables can also live in the \"env\" block of ~/.claude/settings.json. Restart Claude Code after changing them."
    ],
    "env": {
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
    }
  },
  "docs": "https://code.claude.com/docs/en/env-vars"
}
