{
  "$schema": "../app.schema.json",
  "id": "edge",
  "name": "Microsoft Edge",
  "category": "browsers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends browsing and usage diagnostic data to Microsoft.",
  "default_state": "unknown",
  "detect": {
    "paths": [
      "{config}/microsoft-edge/Local State",
      "{home}/Library/Application Support/Microsoft Edge/Local State",
      "{localappdata}/Microsoft/Edge/User Data/Local State"
    ]
  },
  "checks": [
    {
      "type": "manual"
    }
  ],
  "disable": {
    "steps": [
      "Settings > Privacy, search, and services: turn off the optional diagnostic data and personalization options.",
      "On supported managed Windows and macOS installations, set the DiagnosticData policy to 0 and restart Edge."
    ]
  },
  "docs": "https://learn.microsoft.com/en-us/deployedge/microsoft-edge-policies#diagnosticdata",
  "verification": "qualified",
  "verified_at": "2026-09-08",
  "scope": [
    "usage-analytics"
  ],
  "evidence": [
    "https://learn.microsoft.com/en-us/deployedge/microsoft-edge-policies/metricsreportingenabled",
    "https://learn.microsoft.com/en-us/deployedge/microsoft-edge-policies/diagnosticdata"
  ]
}
