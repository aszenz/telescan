{
  "$schema": "../app.schema.json",
  "id": "ionic",
  "name": "Ionic CLI",
  "category": "frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "what": "Sends anonymous command usage.",
  "default_state": "on",
  "detect": {
    "which": [
      "ionic"
    ],
    "paths": [
      "{home}/.ionic/config.json"
    ]
  },
  "checks": [
    {
      "type": "json",
      "key": "telemetry",
      "files": [
        "{home}/.ionic/config.json"
      ],
      "disabled_when": [
        "*falsy*"
      ],
      "enabled_when": [
        "*truthy*"
      ]
    }
  ],
  "disable": {
    "steps": [
      "Run: ionic config set -g telemetry false"
    ],
    "commands": [
      "ionic config set -g telemetry false"
    ]
  },
  "docs": "https://ionicframework.com/docs/cli/telemetry"
}
